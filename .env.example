# =============================================================================
# PPI_Predictor_Api Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=ppi_user
POSTGRES_PASSWORD=ppi_password
POSTGRES_DB=ppi_predictor

# Direct database connection string (alternative, for external DB like Neon)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database
# DB_CONNECTION_STRING=postgresql://user:password@host:5432/database

# -----------------------------------------------------------------------------
# Security (REQUIRED - Change these in production!)
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-me
SECRET_KEY=your-super-secret-flask-key-change-me

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for verification emails)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@zohomail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="Protein Predictor <ppi_predictor@zohomail.com>"

# Verification code expiry in minutes
VERIFICATION_EXP_MIN=10

# -----------------------------------------------------------------------------
# Flask Configuration
# -----------------------------------------------------------------------------
# Options: development, production
FLASK_ENV=development

# -----------------------------------------------------------------------------
# PGAdmin (Optional - only if using --profile tools)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
